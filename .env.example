# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)

# Claude API — ถ้าไม่ใส่ ระบบใช้ตัวแปลง/ตัวคัด Lead แบบกฎแทน AI
# ตั้งเพดานงบรายเดือนได้ที่ https://console.anthropic.com → Settings → Limits
ANTHROPIC_API_KEY=

# LINE Official Account (Messaging API) — สำหรับส่ง New Lead ทุกเช้า
# สร้าง OA ที่ https://manager.line.biz → เปิด Messaging API → คัดลอก Channel access token
LINE_CHANNEL_ACCESS_TOKEN=

# สำหรับ scheduler 08:00 (ตอนขึ้นเซิร์ฟเวอร์จริง)
CRON_SECRET=
APP_URL=

# --- เฟสถัดไป (หลังได้รับอนุญาตจาก IT) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
